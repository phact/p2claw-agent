{
  "name": "@p2claw/agent-client",
  "version": "0.1.0-pre",
  "description": "Client for the p2claw agent's local API: manage apps, shares and email, and reach private apps shared from other machines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "ws": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
